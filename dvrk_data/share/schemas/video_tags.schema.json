{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dvrk_data:video_tags@1.0.0",
  "title": "Video Tags Metadata",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "dvrk_data:video_tags@1.0.0"
    },
    "video_file": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "start": {
            "type": "object",
            "properties": {
              "cpu_ts": {
                "type": "integer"
              },
              "frame_relative": {
                "type": "integer"
              },
              "frame_absolute": {
                "type": "integer"
              },
              "generated_at": {
                "type": "string"
              }
            }
          },
          "end": {
            "type": "object",
            "properties": {
              "cpu_ts": {
                "type": "integer"
              },
              "frame_relative": {
                "type": "integer"
              },
              "frame_absolute": {
                "type": "integer"
              },
              "generated_at": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      }
    }
  },
  "required": ["type"]
}
