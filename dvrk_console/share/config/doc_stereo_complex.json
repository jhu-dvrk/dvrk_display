{
  "type": "dvrk_console:stereo_display@1.0.0",
  "name": "stereo_complex",
  "dvrk_console_namespace": "console",
  "sinks": ["glimage", "glimages"],
  "overlay_alpha": 0.5,
  "extra_streams": {
    "monos": [
      "videotestsrc pattern=snow ! video/x-raw,width=320,height=240,framerate=10/1"
    ],
    "scale": 0.3
  },
  "camera": {
    "size": {
      "width": 640,
      "height": 480
    },
    "left": {
      "stream": "videotestsrc pattern=white ! video/x-raw,width=640,height=480,framerate=30/1"
    },
    "right": {
      "stream": "videotestsrc pattern=black ! video/x-raw,width=640,height=480,framerate=30/1"
    },
    "crop": {
      "width": 640,
      "height": 480
    }
  }
}
