{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dd::display_config@1.0.0",
  "title": "dvrk_display stereo configuration",
  "description": "Configuration file for the dvrk_display stereo executable.",
  "type": "object",
  "required": ["type", "camera"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "dd::display_config@1.0.0"
    },
    "name": {
      "type": "string",
      "default": "dvrk_display"
    },
    "dvrk_console_namespace": {
      "type": "string",
      "default": "console"
    },
    "ros_image_publishers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["left", "right", "stereo"]
      },
      "uniqueItems": true,
      "default": []
    },
    "overlay_alpha": {
      "type": "number",
      "default": 0.7,
      "minimum": 0.0,
      "maximum": 1.0
    },
    "preserve_size": {
      "type": "boolean",
      "default": true
    },
    "display_horizontal_offset_px": {
      "type": "integer",
      "default": 0
    },
    "camera": {
      "type": "object",
      "required": ["size", "left", "right"],
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "left": {
          "$ref": "#/definitions/cameraStream"
        },
        "right": {
          "$ref": "#/definitions/cameraStream"
        },
        "crop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "alignment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "horizontal_shift_px": {
              "type": "integer",
              "default": 0
            },
            "vertical_shift_px": {
              "type": "integer",
              "default": 0
            }
          }
        }
      }
    },
    "sinks": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["glimage", "glimages"]
      },
      "default": []
    },
    "unixfdsinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stream"],
        "additionalProperties": false,
        "properties": {
          "stream": {
            "type": "string",
            "enum": ["left", "right", "stereo", "overlay"]
          },
          "name": {
            "type": "string"
          },
          "socket_path": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "extra_streams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "stereos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["left", "right"],
            "additionalProperties": false,
            "properties": {
              "left": {
                "type": "string"
              },
              "right": {
                "type": "string"
              }
            }
          },
          "default": []
        },
        "scale": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 0.99,
          "default": 0.3
        }
      }
    },
    "ar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "left_socket": {
          "type": "string"
        },
        "right_socket": {
          "type": "string"
        },
        "color_key": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  },
  "definitions": {
    "cameraStream": {
      "type": "object",
      "required": ["stream"],
      "additionalProperties": false,
      "properties": {
        "stream": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "$ref": "#/definitions/colorAdjustment"
        }
      }
    },
    "colorAdjustment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brightness": {
          "type": "number",
          "default": 0.0
        },
        "contrast": {
          "type": "number",
          "default": 1.0
        },
        "saturation": {
          "type": "number",
          "default": 1.0
        },
        "hue": {
          "type": "number",
          "default": 0.0
        }
      }
    }
  }
}
