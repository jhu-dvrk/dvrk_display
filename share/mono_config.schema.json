{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dd::mono_config@1.0.0",
  "title": "dvrk_display mono configuration",
  "description": "Configuration file for the dvrk_display mono executable.",
  "type": "object",
  "required": ["type", "camera"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "dd::mono_config@1.0.0"
    },
    "name": {
      "type": "string",
      "default": "dvrk_display_mono"
    },
    "dvrk_console_namespace": {
      "type": "string",
      "default": "console"
    },
    "ros_image_publishers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["mono"]
      },
      "uniqueItems": true,
      "default": []
    },
    "overlay_alpha": {
      "type": "number",
      "default": 0.7,
      "minimum": 0.0,
      "maximum": 1.0
    },
    "preserve_size": {
      "type": "boolean",
      "default": true
    },
    "display_horizontal_offset_px": {
      "type": "integer",
      "default": 0
    },
    "camera": {
      "type": "object",
      "required": ["stream"],
      "additionalProperties": false,
      "properties": {
        "stream": {
          "type": "string",
          "minLength": 1,
          "description": "GStreamer pipeline fragment for the mono camera source."
        },
        "size": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "color": {
          "$ref": "#/definitions/colorAdjustment"
        }
      }
    },
    "sinks": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["glimage", "glimages"]
      },
      "default": []
    },
    "unixfdsinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stream"],
        "additionalProperties": false,
        "properties": {
          "stream": {
            "type": "string",
            "enum": ["raw", "overlay"]
          },
          "name": {
            "type": "string"
          },
          "socket_path": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "unixfd_socket_path": {
      "type": "string"
    }
  },
  "definitions": {
    "colorAdjustment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brightness": {
          "type": "number",
          "default": 0.0
        },
        "contrast": {
          "type": "number",
          "default": 1.0
        },
        "saturation": {
          "type": "number",
          "default": 1.0
        },
        "hue": {
          "type": "number",
          "default": 0.0
        }
      }
    }
  }
}
